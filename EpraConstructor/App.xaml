<Application x:Class="EpraConstructor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ═══════════════ BRUSHES (тёмная по умолчанию) ═══════════════ -->
            <SolidColorBrush x:Key="BgBrush"            Color="#070709"/>
            <SolidColorBrush x:Key="BgPanelBrush"       Color="#0D0D12"/>
            <SolidColorBrush x:Key="BgCardBrush"        Color="#10101A"/>
            <SolidColorBrush x:Key="BgInputBrush"       Color="#0A0A0F"/>
            <SolidColorBrush x:Key="BgPopupBrush"       Color="#0F0F18"/>
            <SolidColorBrush x:Key="BorderDimBrush"     Color="#1E1E30"/>
            <SolidColorBrush x:Key="BorderMidBrush"     Color="#2A2A40"/>

            <SolidColorBrush x:Key="NeonGreenBrush"     Color="#00FF88"/>
            <SolidColorBrush x:Key="NeonCyanBrush"      Color="#00E5FF"/>
            <SolidColorBrush x:Key="NeonRedBrush"       Color="#FF0040"/>
            <SolidColorBrush x:Key="NeonYellowBrush"    Color="#FFDD00"/>
            <SolidColorBrush x:Key="NeonOrangeBrush"    Color="#FF9500"/>
            <SolidColorBrush x:Key="NeonWhiteBrush"     Color="#E0E8FF"/>

            <SolidColorBrush x:Key="DimCyanBrush"       Color="#5599BB"/>
            <SolidColorBrush x:Key="DimGreenBrush"      Color="#337755"/>
            <SolidColorBrush x:Key="DimTextBrush"       Color="#99AABB"/>
            <SolidColorBrush x:Key="FgBrush"            Color="#D8E8F8"/>

            <SolidColorBrush x:Key="TransparentBrush"   Color="Transparent"/>
            <SolidColorBrush x:Key="ErrorBtnBgBrush"    Color="#1A0A10"/>
            <SolidColorBrush x:Key="ErrorBtnBgBadBrush" Color="#2A0010"/>

            <!-- ═══════════════ HOVER / PRESSED ═══════════════ -->
            <SolidColorBrush x:Key="HoverBgBrush"           Color="#1E1E30"/>
            <SolidColorBrush x:Key="PressedBgBrush"         Color="#0A0A0F"/>
            <SolidColorBrush x:Key="BtnGreenHoverBrush"     Color="#153D26"/>
            <SolidColorBrush x:Key="BtnCyanHoverBrush"      Color="#153545"/>
            <SolidColorBrush x:Key="BtnRedHoverBrush"       Color="#3D1018"/>
            <SolidColorBrush x:Key="BtnYellowHoverBrush"    Color="#3D3300"/>
            <SolidColorBrush x:Key="CaptionBtnHoverBrush"   Color="#1E1E30"/>
            <SolidColorBrush x:Key="CaptionBtnPressedBrush" Color="#0A0A0F"/>

            <!-- ═══════════════ STATUS / BADGES ═══════════════ -->
            <SolidColorBrush x:Key="BadgeGreenBgBrush"      Color="#0F2A10"/>
            <SolidColorBrush x:Key="BadgeStatusBgBrush"     Color="#051A10"/>
            <SolidColorBrush x:Key="BadgeStatusBorderBrush" Color="#226644"/>
            <SolidColorBrush x:Key="StatusOnlineBrush"      Color="#00AA55"/>
            <SolidColorBrush x:Key="ServiceBadgeBgBrush"    Color="#2A1000"/>
            <SolidColorBrush x:Key="SaveOverlayBgBrush"     Color="#CC000000"/>

            <!-- ═══════════════ START MODE ═══════════════ -->
            <SolidColorBrush x:Key="StartMode7BgBrush"          Color="#1A0A10"/>
            <SolidColorBrush x:Key="StartMode7BorderBrush"      Color="#440020"/>
            <SolidColorBrush x:Key="StartMode7HoverBgBrush"     Color="#2A1020"/>
            <SolidColorBrush x:Key="StartMode7HoverBorderBrush" Color="#FF0040"/>

            <SolidColorBrush x:Key="StartMode4BgBrush"          Color="#1A1A08"/>
            <SolidColorBrush x:Key="StartMode4BorderBrush"      Color="#555500"/>
            <SolidColorBrush x:Key="StartMode4HoverBgBrush"     Color="#2A2A10"/>
            <SolidColorBrush x:Key="StartMode4HoverBorderBrush" Color="#FFDD00"/>

            <SolidColorBrush x:Key="StartMode1BgBrush"          Color="#0A1A08"/>
            <SolidColorBrush x:Key="StartMode1BorderBrush"      Color="#224422"/>
            <SolidColorBrush x:Key="StartMode1HoverBgBrush"     Color="#102A18"/>
            <SolidColorBrush x:Key="StartMode1HoverBorderBrush" Color="#00FF88"/>

            <SolidColorBrush x:Key="StartMode0BgBrush"          Color="#0A1820"/>
            <SolidColorBrush x:Key="StartMode0BorderBrush"      Color="#224466"/>
            <SolidColorBrush x:Key="StartMode0HoverBgBrush"     Color="#102838"/>
            <SolidColorBrush x:Key="StartMode0HoverBorderBrush" Color="#00E5FF"/>

            <!-- ═══════════════ TEXT STYLES ═══════════════ -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{DynamicResource FgBrush}"/>
                <Setter Property="FontFamily"  Value="Segoe UI"/>
                <Setter Property="FontSize"    Value="13"/>
            </Style>

            <Style x:Key="NeonLabel" TargetType="TextBlock">
                <Setter Property="Foreground"   Value="{DynamicResource DimCyanBrush}"/>
                <Setter Property="FontFamily"   Value="Consolas"/>
                <Setter Property="FontSize"     Value="11"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{DynamicResource NeonWhiteBrush}"/>
                <Setter Property="FontFamily"  Value="Segoe UI"/>
                <Setter Property="FontSize"    Value="13"/>
                <Setter Property="FontWeight"  Value="Bold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="MonoValue" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{DynamicResource NeonCyanBrush}"/>
                <Setter Property="FontFamily"  Value="Consolas"/>
                <Setter Property="FontSize"    Value="15"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="MonoValueSmall" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{DynamicResource NeonCyanBrush}"/>
                <Setter Property="FontFamily"  Value="Consolas"/>
                <Setter Property="FontSize"    Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="StatusLabel" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{DynamicResource DimTextBrush}"/>
                <Setter Property="FontFamily"  Value="Consolas"/>
                <Setter Property="FontSize"    Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ═══════════════ PANEL BORDER ═══════════════ -->
            <Style x:Key="PanelBorder" TargetType="Border">
                <Setter Property="Background"       Value="{DynamicResource BgCardBrush}"/>
                <Setter Property="BorderBrush"      Value="{DynamicResource BorderDimBrush}"/>
                <Setter Property="BorderThickness"  Value="1"/>
                <Setter Property="CornerRadius"     Value="4"/>
                <Setter Property="Padding"          Value="12"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- ═══════════════ SERVICE-GATED ═══════════════ -->
            <!-- Раньше был Opacity 0.30 — в светлой теме давало «мыло».
                 Теперь только лёгкое приглушение через Opacity 0.75. -->
            <Style x:Key="ServiceGated" TargetType="FrameworkElement">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.75"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ServiceSectionBorder" TargetType="Border"
                   BasedOn="{StaticResource PanelBorder}">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.80"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDimBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ═══════════════ TEXTBOX ═══════════════ -->
            <Style TargetType="TextBox">
                <Setter Property="Background"            Value="{DynamicResource BgInputBrush}"/>
                <Setter Property="Foreground"            Value="{DynamicResource NeonCyanBrush}"/>
                <Setter Property="CaretBrush"            Value="{DynamicResource NeonCyanBrush}"/>
                <Setter Property="FontFamily"            Value="Consolas"/>
                <Setter Property="FontSize"              Value="13"/>
                <Setter Property="BorderThickness"       Value="1"/>
                <Setter Property="Padding"               Value="6,4"/>
                <Setter Property="SnapsToDevicePixels"   Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource BorderMidBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Background="Transparent"
                                              Focusable="False"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush"
                                            Value="{DynamicResource NeonCyanBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush"
                                            Value="{DynamicResource DimCyanBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════ COMBOBOX ═══════════════ -->
            <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource BgInputBrush}"
                                    BorderBrush="{DynamicResource BorderMidBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Arrow"
                                          Grid.Column="1"
                                          Data="M0,0 L4,5 L8,0"
                                          Stroke="{DynamicResource DimCyanBrush}"
                                          StrokeThickness="1.5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush"
                                            Value="{DynamicResource NeonCyanBrush}"/>
                                    <Setter TargetName="Arrow" Property="Stroke"
                                            Value="{DynamicResource NeonCyanBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush"
                                            Value="{DynamicResource DimCyanBrush}"/>
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource HoverBgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
                <Setter Property="Background"     Value="Transparent"/>
                <Setter Property="Foreground"     Value="{DynamicResource FgBrush}"/>
                <Setter Property="FontFamily"     Value="Consolas"/>
                <Setter Property="FontSize"       Value="13"/>
                <Setter Property="Padding"        Value="10,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBd"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background"
                                            Value="{DynamicResource HoverBgBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background"
                                            Value="{DynamicResource HoverBgBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Background"          Value="{DynamicResource BgInputBrush}"/>
                <Setter Property="Foreground"          Value="{DynamicResource NeonCyanBrush}"/>
                <Setter Property="FontFamily"          Value="Consolas"/>
                <Setter Property="FontSize"            Value="13"/>
                <Setter Property="BorderThickness"     Value="1"/>
                <Setter Property="Height"              Value="30"/>
                <Setter Property="Padding"             Value="6,0,0,0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="0"
                                                      MinWidth="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}"/>
                                </Grid.ColumnDefinitions>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       PopupAnimation="Slide"
                                       MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border x:Name="PopupBorder"
                                            Background="{DynamicResource BgPopupBrush}"
                                            BorderBrush="{DynamicResource BorderMidBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                                <ToggleButton x:Name="ToggleButton"
                                              Grid.Column="0" Grid.ColumnSpan="2"
                                              Style="{StaticResource ComboBoxToggleButton}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="6,0,22,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.75"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════ SCROLLBAR ═══════════════ -->
            <Style x:Key="ScrollBarRepeatButton" TargetType="RepeatButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" Width="8" Height="8"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ScrollBarThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource BorderMidBrush}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource NeonCyanBrush}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource NeonGreenBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle"  Value="True"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="8"/>
                        <Setter Property="MinWidth" Value="100"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid>
                                        <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="4"/>
                                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource ScrollBarRepeatButton}"
                                                              Command="ScrollBar.LineLeftCommand"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ScrollBarThumb}" Height="8"/>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource ScrollBarRepeatButton}"
                                                              Command="ScrollBar.LineRightCommand"/>
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width" Value="8"/>
                        <Setter Property="MinHeight" Value="100"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid>
                                        <Border Background="{DynamicResource BgPanelBrush}" CornerRadius="4"/>
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource ScrollBarRepeatButton}"
                                                              Command="ScrollBar.LineUpCommand"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ScrollBarThumb}" Width="8"/>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource ScrollBarRepeatButton}"
                                                              Command="ScrollBar.LineDownCommand"/>
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ScrollContentPresenter Grid.Column="0" Grid.Row="0"/>
                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Column="1" Grid.Row="0"
                                           Orientation="Vertical"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                <ScrollBar x:Name="PART_HorizontalScrollBar"
                                           Grid.Column="0" Grid.Row="1"
                                           Orientation="Horizontal"
                                           Value="{TemplateBinding HorizontalOffset}"
                                           Maximum="{TemplateBinding ScrollableWidth}"
                                           ViewportSize="{TemplateBinding ViewportWidth}"
                                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════ SLIDER ═══════════════ -->
            <Style x:Key="SliderRepBtn" TargetType="RepeatButton">
                <Setter Property="Focusable"  Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" Height="6"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SliderRepBtnLeft" TargetType="RepeatButton">
                <Setter Property="Focusable"  Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="{DynamicResource NeonGreenBrush}"
                                    Height="6" CornerRadius="3 0 0 3"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NeonSliderThumb" TargetType="Thumb">
                <Setter Property="Width"  Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Ellipse x:Name="Circle"
                                     Width="20" Height="20"
                                     Fill="{DynamicResource NeonGreenBrush}"
                                     Stroke="{DynamicResource NeonGreenBrush}"
                                     StrokeThickness="1"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Circle" Property="Width" Value="22"/>
                                    <Setter TargetName="Circle" Property="Height" Value="22"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Circle" Property="Width" Value="24"/>
                                    <Setter TargetName="Circle" Property="Height" Value="24"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NeonSlider" TargetType="Slider">
                <Setter Property="Focusable"           Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Border Background="Transparent" Padding="10,0">
                                <Grid>
                                    <Border Height="6" CornerRadius="3"
                                            Background="{DynamicResource BorderDimBrush}"
                                            VerticalAlignment="Center"
                                            Margin="0"/>
                                    <Track x:Name="PART_Track" VerticalAlignment="Center">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource SliderRepBtnLeft}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource NeonSliderThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource SliderRepBtn}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.65"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════ PROGRESSBAR ═══════════════ -->
            <Style x:Key="PbGreen" TargetType="ProgressBar">
                <Setter Property="Height"              Value="10"/>
                <Setter Property="Background"          Value="{DynamicResource BorderDimBrush}"/>
                <Setter Property="BorderThickness"     Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track" Height="{TemplateBinding Height}">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="5"
                                        Background="{DynamicResource NeonGreenBrush}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PbCyan" TargetType="ProgressBar">
                <Setter Property="Height"              Value="10"/>
                <Setter Property="Background"          Value="{DynamicResource BorderDimBrush}"/>
                <Setter Property="BorderThickness"     Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track" Height="{TemplateBinding Height}">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="5"
                                        Background="{DynamicResource NeonCyanBrush}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PbOrange" TargetType="ProgressBar">
                <Setter Property="Height"              Value="10"/>
                <Setter Property="Background"          Value="{DynamicResource BorderDimBrush}"/>
                <Setter Property="BorderThickness"     Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="PART_Track" Height="{TemplateBinding Height}">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="5"
                                        Background="{DynamicResource NeonOrangeBrush}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════ TOGGLE SWITCH ═══════════════ -->
            <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
                <Setter Property="Width"            Value="52"/>
                <Setter Property="Height"           Value="28"/>
                <Setter Property="Cursor"           Value="Hand"/>
                <Setter Property="Focusable"        Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid Width="52" Height="28">
                                <Border x:Name="Track"
                                        CornerRadius="14"
                                        Background="{DynamicResource BorderDimBrush}"
                                        BorderBrush="{DynamicResource BorderMidBrush}"
                                        BorderThickness="1"/>
                                <Canvas Width="52" Height="28">
                                    <Ellipse x:Name="Thumb"
                                             Width="22" Height="22"
                                             Fill="{DynamicResource BgPanelBrush}"
                                             Stroke="{DynamicResource BorderMidBrush}"
                                             StrokeThickness="1"
                                             Canvas.Left="3"
                                             Canvas.Top="3"/>
                                </Canvas>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track"  Property="Background"    Value="{DynamicResource BgPanelBrush}"/>
                                    <Setter TargetName="Track"  Property="BorderBrush"   Value="{DynamicResource NeonGreenBrush}"/>
                                    <Setter TargetName="Thumb"  Property="Fill"          Value="{DynamicResource NeonGreenBrush}"/>
                                    <Setter TargetName="Thumb"  Property="Stroke"        Value="{DynamicResource NeonGreenBrush}"/>
                                    <Setter TargetName="Thumb"  Property="Canvas.Left"   Value="27"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked"   Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource DimCyanBrush}"/>
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                    <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource BgPanelBrush}"/>
                                    <Setter TargetName="Thumb" Property="Stroke" Value="{DynamicResource DimCyanBrush}"/>
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked"    Value="True"/>
                                        <Condition Property="IsMouseOver"  Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource NeonGreenBrush}"/>
                                    <Setter TargetName="Thumb" Property="Stroke" Value="{DynamicResource NeonGreenBrush}"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.65"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════ CHECKBOX ═══════════════ -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize"   Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Box"
                                        Width="16" Height="16"
                                        CornerRadius="3"
                                        Background="{DynamicResource BgInputBrush}"
                                        BorderBrush="{DynamicResource BorderMidBrush}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <Path x:Name="Tick"
                                          Data="M2,8 L6,12 L14,4"
                                          Stroke="{DynamicResource NeonGreenBrush}"
                                          StrokeThickness="2"
                                          Visibility="Collapsed"
                                          SnapsToDevicePixels="True"/>
                                </Border>
                                <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Tick"  Property="Visibility"   Value="Visible"/>
                                    <Setter TargetName="Box"   Property="BorderBrush"  Value="{DynamicResource NeonGreenBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource DimCyanBrush}"/>
                                    <Setter TargetName="Box" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══════════════ BUTTONS ═══════════════ -->
            <Style TargetType="Button">
                <Setter Property="Background"        Value="{DynamicResource BgCardBrush}"/>
                <Setter Property="Foreground"        Value="{DynamicResource FgBrush}"/>
                <Setter Property="FontFamily"        Value="Segoe UI"/>
                <Setter Property="FontSize"          Value="13"/>
                <Setter Property="BorderThickness"   Value="1"/>
                <Setter Property="BorderBrush"       Value="{DynamicResource BorderMidBrush}"/>
                <Setter Property="Padding"           Value="12,6"/>
                <Setter Property="Cursor"            Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource HoverBgBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource PressedBgBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BtnGreen" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground"   Value="{DynamicResource NeonGreenBrush}"/>
                <Setter Property="BorderBrush"  Value="{DynamicResource NeonGreenBrush}"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BtnGreenHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BtnCyan" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground"   Value="{DynamicResource NeonCyanBrush}"/>
                <Setter Property="BorderBrush"  Value="{DynamicResource NeonCyanBrush}"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BtnCyanHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BtnRed" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground"   Value="{DynamicResource NeonRedBrush}"/>
                <Setter Property="BorderBrush"  Value="{DynamicResource NeonRedBrush}"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BtnRedHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BtnYellow" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground"   Value="{DynamicResource NeonYellowBrush}"/>
                <Setter Property="BorderBrush"  Value="{DynamicResource NeonYellowBrush}"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BtnYellowHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BtnServiceEnter" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground"   Value="{DynamicResource NeonGreenBrush}"/>
                <Setter Property="BorderBrush"  Value="{DynamicResource NeonGreenBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BtnGreenHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BtnServiceExit" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground"   Value="{DynamicResource NeonYellowBrush}"/>
                <Setter Property="BorderBrush"  Value="{DynamicResource NeonYellowBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontWeight"   Value="Bold"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BtnYellowHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CaptionBtn" TargetType="Button">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{DynamicResource DimTextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width"           Value="40"/>
                <Setter Property="Height"          Value="40"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="FontFamily"      Value="Segoe UI"/>
                <Setter Property="FontSize"        Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource CaptionBtnHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource CaptionBtnPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BtnRedHoverBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource NeonRedBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BtnRedHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ToolbarSep" TargetType="Border">
                <Setter Property="Width"      Value="1"/>
                <Setter Property="Background" Value="{DynamicResource BorderMidBrush}"/>
                <Setter Property="Margin"     Value="6,4"/>
            </Style>

            <!-- ═══════════════ START MODE ═══════════════ -->

            <!-- База: Opacity 0.75 вместо 0.45 — в светлой теме не «мылит».
                 Hover — усиление до 1.0 + подсветка рамки. -->
            <Style x:Key="StartModeBase" TargetType="Border">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource BgInputBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderMidBrush}"/>
                <Setter Property="Opacity" Value="0.75"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="1.0"/>
                        <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource DimCyanBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StartMode7Style" TargetType="Border" BasedOn="{StaticResource StartModeBase}">
                <Setter Property="Background" Value="{DynamicResource StartMode7BgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource StartMode7BorderBrush}"/>
            </Style>

            <Style x:Key="StartMode4Style" TargetType="Border" BasedOn="{StaticResource StartModeBase}">
                <Setter Property="Background" Value="{DynamicResource StartMode4BgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource StartMode4BorderBrush}"/>
            </Style>

            <Style x:Key="StartMode1Style" TargetType="Border" BasedOn="{StaticResource StartModeBase}">
                <Setter Property="Background" Value="{DynamicResource StartMode1BgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource StartMode1BorderBrush}"/>
            </Style>

            <Style x:Key="StartMode0Style" TargetType="Border" BasedOn="{StaticResource StartModeBase}">
                <Setter Property="Background" Value="{DynamicResource StartMode0BgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource StartMode0BorderBrush}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>