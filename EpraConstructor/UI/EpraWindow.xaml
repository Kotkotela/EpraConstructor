<UserControl x:Class="EpraConstructor.EpraWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Height="346" Width="293"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Border x:Name="CardBorder"
            Style="{StaticResource PanelBorder}"
            Width="280" Margin="8,6,8,6"
            VerticalAlignment="Top" Height="342"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow"
                              Color="#00FF88"
                              BlurRadius="0"
                              ShadowDepth="0"
                              Opacity="0"/>
        </Border.Effect>

        <Grid>
            <!-- Полоска слева (insert перед) -->
            <Border x:Name="InsertLeftBar"
                    Width="4"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource NeonGreenBrush}"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Margin="-2,0,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#00FF88" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                </Border.Effect>
            </Border>

            <!-- Полоска справа (insert после) -->
            <Border x:Name="InsertRightBar"
                    Width="4"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource NeonGreenBrush}"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Margin="0,0,-2,0">
                <Border.Effect>
                    <DropShadowEffect Color="#00FF88" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                </Border.Effect>
            </Border>

            <!-- Обводка для swap (полная подсветка) -->
            <Border x:Name="SwapBorder"
                    BorderBrush="{DynamicResource NeonGreenBrush}"
                    BorderThickness="3"
                    CornerRadius="4"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#00FF88" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/>
                </Border.Effect>
            </Border>

            <!-- Контент карточки -->
            <StackPanel>
                <!-- Card Header -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StatusDot" Grid.Column="0" Width="10" Height="10" 
                             Margin="0,0,6,0" VerticalAlignment="Center"
                             SnapsToDevicePixels="True">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#00FF88"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- ШАПКА: за неё тащим -->
                    <StackPanel Grid.Column="1"
                                Background="Transparent"
                                Cursor="SizeAll"
                                MouseLeftButtonDown="DeviceHeader_MouseLeftButtonDown"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDeviceName" Text="ЭПРА"
                                   Style="{StaticResource SectionTitle}"
                                   SnapsToDevicePixels="True"
                                   UseLayoutRounding="True"/>
                    </StackPanel>

                    <!-- БЕЙДЖ С АДРЕСОМ -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource BgPanelBrush}"
                            BorderBrush="{DynamicResource NeonCyanBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,2"
                            Margin="6,0,4,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="A:"
                                       FontFamily="Consolas" FontSize="9"
                                       Foreground="{DynamicResource DimCyanBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,2,0"/>
                            <TextBlock x:Name="TxtDeviceAddress"
                                       Text="0"
                                       FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource NeonCyanBrush}"
                                       VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- БЕЙДЖ ПАРАМЕТРОВ СВЯЗИ -->
                    <Border Grid.Column="3"
                            Background="{DynamicResource BgPanelBrush}"
                            BorderBrush="{DynamicResource NeonCyanBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,3"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="TxtLinkInfo"
                                   Text="—"
                                   FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource NeonCyanBrush}"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Button x:Name="BtnExpand" Grid.Column="4" Content="⤢"
                            Style="{StaticResource CaptionBtn}"
                            Width="28" Height="28" FontSize="13"
                            Foreground="{DynamicResource DimCyanBrush}"
                            ToolTip="Развернуть"
                            Click="BtnExpand_Click"/>

                    <Button x:Name="BtnDelete" Grid.Column="5" Content="✕"
                            Style="{StaticResource CaptionBtn}"
                            Width="28" Height="28" FontSize="11"
                            Foreground="{DynamicResource NeonRedBrush}"
                            ToolTip="Удалить"
                            Click="BtnDelete_Click"/>
                </Grid>

                <Separator Margin="0,0,0,8" Background="{DynamicResource BorderDimBrush}" Height="1"
                           SnapsToDevicePixels="True"/>

                <!-- Poll status -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Опрос:" Style="{StaticResource NeonLabel}" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtPollTime" Text="—" Style="{StaticResource MonoValueSmall}"/>
                        <TextBlock Text="  |  " Foreground="{DynamicResource BorderMidBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="ОТКЛ." FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource NeonRedBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtQueueSep" Text="  |  " Foreground="{DynamicResource BorderMidBrush}"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtQueue" Text="" Style="{StaticResource NeonLabel}"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>

                    <ToggleButton x:Name="ToggleConnection" Grid.Column="1" 
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="True" ToolTip="Подключение вкл/выкл"/>
                </Grid>

                <!-- Lamp button -->
                <Button x:Name="BtnLamp" Content="☀  Вкл"
                        HorizontalAlignment="Stretch" Margin="0,0,0,8"
                        Click="BtnLamp_Click"/>

                <!-- Current slider -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ток уставки" Style="{StaticResource NeonLabel}" Margin="0,0,0,3"/>
                        <Slider x:Name="SliderCurrent" Style="{StaticResource NeonSlider}"
                                Thumb.DragCompleted="SliderCurrent_DragCompleted"
                                Minimum="50" Maximum="100" Value="0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtCurrentValue" Grid.Column="1" Text="0%" 
                               Style="{StaticResource MonoValueSmall}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,3"/>
                </Grid>

                <!-- Progress bars -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Уров. стаб" Style="{StaticResource NeonLabel}" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="PbVoltage" Grid.Row="0" Grid.Column="1" Style="{StaticResource PbGreen}" Value="0" Maximum="100" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtVoltage" Grid.Row="0" Grid.Column="2" Text="—" Style="{StaticResource MonoValueSmall}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Мощн.потр" Style="{StaticResource NeonLabel}" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="PbCurrent" Grid.Row="1" Grid.Column="1" Style="{StaticResource PbCyan}" Value="0" Maximum="100" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCurrent" Grid.Row="1" Grid.Column="2" Text="—" Style="{StaticResource MonoValueSmall}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ток лампы" Style="{StaticResource NeonLabel}" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="PbTemp" Grid.Row="2" Grid.Column="1" Style="{StaticResource PbOrange}" Value="0" Maximum="100" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTemp" Grid.Row="2" Grid.Column="2" Text="—" Style="{StaticResource MonoValueSmall}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Separator Margin="0,4,0,6" Background="{DynamicResource BorderDimBrush}" Height="1"
                           SnapsToDevicePixels="True"/>

                <!-- Кнопка ошибок -->
                <Button x:Name="BtnErrors"
        Content="✕  Нет ошибок"
        HorizontalAlignment="Stretch"
        Style="{StaticResource BtnRed}"
        FontFamily="Consolas" FontSize="11"
        Click="BtnErrors_Click"/>

                <!-- POPUP: список активных ошибок -->
                <Popup x:Name="ErrorsPopup"
                       PlacementTarget="{Binding ElementName=BtnErrors}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource BgPopupBrush}"
                            BorderBrush="{DynamicResource NeonRedBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            MaxWidth="340">
                        <StackPanel>
                            <TextBlock Text="⚑ Активные ошибки"
                                       FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource NeonRedBrush}"
                                       Margin="0,0,0,6"/>

                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ErrorsList"/>
                            </ScrollViewer>

                            <TextBlock x:Name="ErrorsEmptyText"
                                       Text="Нет активных ошибок"
                                       FontFamily="Consolas" FontSize="10"
                                       Foreground="{DynamicResource DimTextBrush}"
                                       Margin="0,4,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>